# Database: leave unset to use SQLite (./hiresense.db, zero setup).
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://hiresense:change_this_local_password@localhost:5432/hiresense
DATABASE_URL=sqlite:///./hiresense.db
# Long random string — required in production for JWT signing.
SECRET_KEY=change-me-to-a-long-random-string
MAX_UPLOAD_BYTES=5242880
FRONTEND_ORIGIN=http://localhost:3000
# 1 = try sentence-transformers embeddings for semantic similarity (downloads a model on first use).
# Default (unset) uses TF-IDF cosine similarity.
HIRESENSE_SEMANTIC_MODEL=
# Uploads per minute per IP.
HIRESENSE_RATE_LIMIT=10
